import { useEffect, useState } from 'react';
import { notificationService } from '../services/notificationService';

export const useNotifications = () => {
  const [isInitialized, setIsInitialized] = useState(false);
  const [isSupported, setIsSupported] = useState(false);
  const [pushToken, setPushToken] = useState<string | null>(null);

  useEffect(() => {
    const initializeNotifications = async () => {
      try {
        setIsSupported(notificationService.isSupported());
        
        if (notificationService.isSupported()) {
          await notificationService.initialize();
          setIsInitialized(true);
          setPushToken(notificationService.getPushToken());
        }
      } catch (error) {
        console.error('Failed to initialize notifications:', error);
      }
    };

    initializeNotifications();
  }, []);

  const scheduleLocalNotification = async (title: string, body: string, data?: any) => {
    return notificationService.scheduleLocalNotification({ title, body, data });
  };

  const scheduleVolunteerReminder = async (opportunityTitle: string, scheduledDate: Date, opportunityId: string) => {
    return notificationService.scheduleVolunteerReminder(opportunityTitle, scheduledDate, opportunityId);
  };

  const scheduleHourTrackingReminder = async () => {
    return notificationService.scheduleHourTrackingReminder();
  };

  const notifyNewOpportunities = async (opportunities: any[]) => {
    return notificationService.notifyNewOpportunities(opportunities);
  };

  const sendTestNotification = async () => {
    return notificationService.sendTestNotification();
  };

  return {
    isInitialized,
    isSupported,
    pushToken,
    scheduleLocalNotification,
    scheduleVolunteerReminder,
    scheduleHourTrackingReminder,
    notifyNewOpportunities,
    sendTestNotification,
    scheduleDailyNotifications,
    ensureDailyNotificationsSetup
  };
};

  const scheduleDailyNotifications = async () => {
    return notificationService.scheduleDailyNotifications();
  };

  const ensureDailyNotificationsSetup = async () => {
    return notificationService.ensureDailyNotificationsSetup();
  };

  // Auto-setup daily notifications on hook initialization
  useEffect(() => {
    if (isInitialized && isSupported) {
      ensureDailyNotificationsSetup();
    }
  }, [isInitialized, isSupported]);
